# Dependencies
node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock

# Audit / Playwright output (regenerate locally; docs examples are committed on purpose)
audit-output/
test-results/
playwright-report/
.playwright/

# Claude-Mem runtime data — never commit the memory database
.claude-mem/
claude-mem-data/
*.sqlite
*.sqlite3
*.db

# Local Claude Code state
.claude/settings.local.json
.claude/.session/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Caches / temp
.cache/
tmp/
temp/
coverage/

# OS / editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# Python bytecode caches (regenerated whenever a skill script runs)
__pycache__/
*.py[cod]
